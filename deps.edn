{:paths ["src"]
 :deps {}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      ;; TEST-ONLY. Parity compiles kotoba/smtp/*.kotoba
                      ;; and runs it against smtp.protocol. Nothing in :paths
                      ;; depends on either of these.
                      ;;
                      ;; Pins are the west pair (amu + kotoba-kir) as of this
                      ;; commit; they are advanced together.
                      ;;
                      ;; Advanced with the annotation removal in kotoba/smtp/:
                      ;; those files now rely on the frontend inferring a
                      ;; parameter's type from its use, so a pin without it
                      ;; would compile them to `expected string, got i64`.
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "93c49982be32459b7671d70a308f0b8998b67477"}
                      io.github.kotoba-lang/kotoba-kir
                      {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
                       :git/sha "ff7a3ae2672f8ecdda54aa1abba3d480a2963733"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; The .cljc suite alone, with no compiler dependency.
  :test-pure
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"
               "-n" "smtp.protocol-test"
               "-n" "smtp.client-test"]}

  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
